{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && ./gradlew build -x test --no-daemon"
  },
  "deploy": {
    "startCommand": "cd backend && java -Xmx512m -Dserver.port=$PORT -Dspring.profiles.active=railway -jar build/libs/trading-bot.jar",
    "healthcheckPath": "/actuator/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
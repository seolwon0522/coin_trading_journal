# ========================================
# Crypto Trading Manager Environment Variables
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# Database Configuration
# ========================================
DB_PASSWORD=secure_password_change_this
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=trader

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# Binance API Configuration
# ========================================
# Get your API keys from https://testnet.binancefuture.com (for testnet)
# or https://www.binance.com/en/my/settings/api-management (for production)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# ========================================
# Security
# ========================================
JWT_SECRET=your-super-secret-jwt-key-change-this
API_KEY=your-api-key-for-internal-services

# ========================================
# Spring Boot Backend
# ========================================
SPRING_PROFILES_ACTIVE=docker
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ========================================
# Nautilus Trading Service
# ========================================
NAUTILUS_SERVICE_URL=http://localhost:8002
MAX_STRATEGIES=10
DEFAULT_CAPITAL=10000
DEFAULT_LEVERAGE=1
RISK_CHECK_ENABLED=true
MAX_POSITION_SIZE=0.1

# ========================================
# Frontend Configuration
# ========================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_NAUTILUS_URL=http://localhost:8002/api/v1

# ========================================
# ML Service Configuration
# ========================================
ML_API_KEY=ml-service-key
ML_MODEL_PATH=./models

# ========================================
# Monitoring
# ========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION_TIME=15d

# ========================================
# Application Settings
# ========================================
NODE_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ========================================
# Email Configuration (Optional)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@cryptotrademanager.com

# ========================================
# Telegram Bot Configuration (Optional)
# ========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ========================================
# Performance Tuning
# ========================================
# Maximum number of concurrent WebSocket connections
MAX_WS_CONNECTIONS=1000

# Database connection pool size
DB_POOL_SIZE=20

# Redis connection pool size
REDIS_POOL_SIZE=10

# ========================================
# Feature Flags
# ========================================
ENABLE_BACKTESTING=true
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_NOTIFICATIONS=true
ENABLE_2FA=false

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_ORDERS_PER_MINUTE=10

# ========================================
# Backup Configuration
# ========================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# ========================================
# Development Settings
# ========================================
HOT_RELOAD=true
MOCK_TRADING=false
VERBOSE_LOGGING=false
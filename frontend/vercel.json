{
  "framework": "nextjs",
  "regions": ["icn1"],
  "functions": {
    "src/app/api/google/token/route.ts": {
      "maxDuration": 10
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://coin-trading-journal-production.up.railway.app/api/v1/:path*"
    }
  ]
}
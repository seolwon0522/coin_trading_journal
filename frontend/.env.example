# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ===== REQUIRED =====

# Backend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# For production: https://your-api.railway.app

# App URL (for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production: https://your-app.vercel.app

# Google OAuth
# Example: 25307816741-f2030iqmhammf9r9l65gt6hv61vjf58p.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== OPTIONAL =====

# Apple OAuth
NEXT_PUBLIC_APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# Monitoring API
NEXT_PUBLIC_MONITORING_API_BASE=http://127.0.0.1:5001
NEXT_PUBLIC_PUBLIC_API_TOKEN=public-readonly

# Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# Error Tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Feature Flags
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_DEMO_MODE=false
# NEXT_PUBLIC_MAINTENANCE_MODE=false